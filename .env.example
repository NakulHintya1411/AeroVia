# AeroVia environment configuration.
# Copy to .env for local development. NEVER commit .env.
# In production, set these as environment variables on your host instead.

# Database. Leave empty locally to use SQLite at instance/aerovia.db.
# Production: a Postgres URL, e.g. postgresql://user:pass@host:5432/aerovia
DATABASE_URL=

# Anthropic API key for the AI Analyst (server-side; users never see it).
# Leave empty to switch the AI Analyst off.
ANTHROPIC_API_KEY=

# Claude model and effort for the AI Analyst (optional).
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium

# Let anyone create an account and organisation (true/false).
# The very first account can always be created, even when this is false.
AEROVIA_ALLOW_SIGNUP=true

# development | staging | production
AEROVIA_ENV=development
